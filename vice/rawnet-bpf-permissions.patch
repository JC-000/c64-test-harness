 # endif
@@ -91,6 +95,31 @@
     if (geteuid() == 0) {
         return true;
     }
+#  ifdef __APPLE__
+    /* macOS has no POSIX capabilities: libpcap access is granted by the
+       permissions on the /dev/bpf* character devices (for example by
+       Wireshark's ChmodBPF, which makes them group access_bpf 0660), so
+       probe those instead of insisting on root.  A node that exists but is
+       busy or denied does not end the search; a missing node does. */
+    {
+        char devname[32];
+        int i;
+
+        for (i = 0; i < 256; i++) {
+            int fd;
+
+            snprintf(devname, sizeof devname, "/dev/bpf%d", i);
+            fd = open(devname, O_RDWR);
+            if (fd >= 0) {
+                close(fd);
+                return true;
+            }
+            if (errno == ENOENT) {
+                break;
+            }
+        }
+    }
+#  endif
 #  ifdef HAVE_CAPABILITIES
     /* check if the CAP_NET_RAW capability is supported */
     if (CAP_IS_SUPPORTED(CAP_NET_RAW)) {
